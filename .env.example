# Copy to .env and fill in. NEVER commit .env — it holds a credential for an entire
# practice's patient records.

# ---------------------------------------------------------------------------
# 1. Which Dentally to talk to
# ---------------------------------------------------------------------------
# uk | sandbox | apac | ca
#
# Defaults to sandbox so an accidental run cannot touch real patient records.
# But note: sandbox access requires Dentally partner approval. A practice using its
# own self-service token has no sandbox, and must set this to its live region (uk).
# When you do, keep DENTALLY_ALLOW_WRITES=0 until you have read docs/SECURITY.md —
# that is then a real patient database.
DENTALLY_REGION=sandbox

# ---------------------------------------------------------------------------
# 2. Credentials — pick ONE mode
# ---------------------------------------------------------------------------
# Mode A: single practice. The practice generates this in Dentally itself.
# Settings -> Integrations / Developer -> generate a token, scoped to the least
# it needs. See docs/LOGIN.md.
DENTALLY_API_TOKEN=

# Mode B: multi-practice OAuth. Issued to you during Dentally partner onboarding.
DENTALLY_CLIENT_ID=
DENTALLY_CLIENT_SECRET=
DENTALLY_REDIRECT_URI=https://your-host.example.com/auth/callback
# Ask for the least you need — an over-broad scope list is a common reason partner
# review stalls, and the practice sees this list on the consent screen.
DENTALLY_SCOPES=user:read patient:read appointment:read
# Dentally hands partners the exact authorize/token URLs at onboarding. Only set
# these if they differ from <api base>/oauth/authorize and /oauth/token.
# DENTALLY_AUTHORIZE_URL=
# DENTALLY_TOKEN_URL=

# ---------------------------------------------------------------------------
# 3. This server
# ---------------------------------------------------------------------------
DENTALLY_MCP_TRANSPORT=stdio
DENTALLY_MCP_HOST=127.0.0.1
DENTALLY_MCP_PORT=8092
DENTALLY_MCP_PUBLIC_URL=https://your-host.example.com

# The bearer token YOUR clients present (MyOTGO, OpenAI, Claude). Not Dentally's.
# The server refuses to start on a non-loopback bind without one.
# Generate: openssl rand -hex 32
DENTALLY_MCP_AUTH_TOKEN=

# Encrypts stored practice tokens at rest.
# Generate: python -m dentally_mcp.tokenstore --genkey
DENTALLY_TOKEN_KEY=
DENTALLY_TOKEN_STORE=tokens.enc

# ---------------------------------------------------------------------------
# 4. Safety — read docs/SECURITY.md before changing any of these
# ---------------------------------------------------------------------------
# Writes are OFF by default. A booking or cancellation made from a prompt-injected
# instruction is not recoverable from the model's side.
DENTALLY_ALLOW_WRITES=0
# Ask the human to confirm each write. Fails closed if the client cannot ask.
DENTALLY_REQUIRE_CONSENT=1
DENTALLY_CONSENT_FALLBACK_ALLOW=0
# Mask contact details and reduce date of birth to an age before anything reaches
# the model. Tooth/surface clinical detail is never exposed regardless.
DENTALLY_REDACT_PII=1
# reception | clinician | nurse | manager | full
DENTALLY_DEFAULT_SURFACE=reception
DENTALLY_AUDIT_LOG=audit.log

# ---------------------------------------------------------------------------
# 5. Limits and upkeep
# ---------------------------------------------------------------------------
# Dentally's documented ceiling is 3,600/hour/user, shared with everything else the
# practice runs. We stay under it.
DENTALLY_RATE_LIMIT_PER_HOUR=3400
# Dentally has NO token refresh — a token stays valid by being used and dies idle.
# This periodic ping is what keeps the integration alive.
DENTALLY_KEEPALIVE=1
DENTALLY_KEEPALIVE_HOURS=12

# Optional error reporting. Inert when empty.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# 6. Behind a reverse proxy (see docs/DEPLOY.md)
# ---------------------------------------------------------------------------
# DNS-rebinding protection. Derived from DENTALLY_MCP_PUBLIC_URL when unset, which
# is usually right. FastMCP only enables this by itself on a loopback bind, so on a
# proxied deployment it would otherwise silently not apply.
# Getting it wrong rejects every request with an opaque 400.
# DENTALLY_MCP_ALLOWED_HOSTS=dentally.example.com
# DENTALLY_MCP_ALLOWED_ORIGINS=https://dentally.example.com

# ---------------------------------------------------------------------------
# 7. DEMO MODE — try it with no Dentally account at all
# ---------------------------------------------------------------------------
# Serves a synthetic practice: invented patients, a populated diary, invoices.
# Only the UPSTREAM is fake — rate limiting, pagination, redaction and role
# scoping are all the real code path, so a demo exercises what actually ships.
# whoami and /healthz both say DEMO in words, so it cannot be mistaken for live data.
# DENTALLY_DEMO=1
